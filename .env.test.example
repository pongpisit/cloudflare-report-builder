# Copy to .env.test and fill in real credentials
# These are NEVER committed to git — .env.test is in .gitignore

# Cloudflare API token (Read-only permissions: Zone Analytics, WAF, SSL, Account Settings)
CF_TOKEN=your-cloudflare-api-token-here

# Zone ID (find in Cloudflare dashboard → Overview → right sidebar)
CF_ZONE_ID=your-zone-id-here

# Account ID (find in Cloudflare dashboard → right sidebar)
CF_ACCOUNT_ID=your-account-id-here

# Optional: the zone's hostname, only used to assert the report cover shows
# the right zone name (tests/e2e/report-flow.spec.ts)
# CF_ZONE_NAME=example.com

# Optional: override the frontend URL used by browser tests (defaults to
# the deployed Pages/Worker URL for this project)
# BASE_URL=https://cloudflare-report-builder.pages.dev

# Optional: override the Worker API base URL used by api-health.spec.ts /
# api-live.spec.ts (defaults to http://localhost:8787 for local `wrangler dev`)
# API_BASE=https://your-worker.your-subdomain.workers.dev
